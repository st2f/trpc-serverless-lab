{
  "name": "@trpc-lab/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/trpc/types.ts"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "npm run typecheck && node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "zod": "^4.6.5"
  }
}
